#!/bin/sh
set -eu
# Upgrade keeps request snapshots and the fixed broker until new postinst commits
# its disabled deployment. Removal only removes known app-only entry/policy bytes.
if [ "$1" = remove ]; then
  /usr/bin/python3 -I "/usr/lib/Skyview Dev Setup/backend/linux/self-update/bootstrap.py" --remove-app-only-disabled
fi
