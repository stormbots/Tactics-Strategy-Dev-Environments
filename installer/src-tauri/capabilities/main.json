{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: fixed workstation operations only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-inspect-system",
    "allow-inspect-schedule",
    "allow-inspect-self-update",
    "allow-set-self-update-paused",
    "allow-run-operation",
    "allow-open-destination",
    "allow-check-application",
    "allow-check-tools",
    "allow-open-release",
    "allow-check-update-preflight"
  ]
}
