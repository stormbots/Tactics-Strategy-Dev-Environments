{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: fixed workstation operations only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-inspect-system",
    "allow-inspect-schedule",
    "allow-inspect-operation-incident",
    "allow-acknowledge-operation-incident",
    "allow-support-context",
    "allow-save-support-report",
    "allow-save-recovery-summary",
    "allow-acknowledge-recovery-incident",
    "allow-list-recovery-reports",
    "allow-read-recovery-report",
    "allow-delete-recovery-report",
    "allow-inspect-self-update",
    "allow-set-self-update-paused",
    "allow-run-operation",
    "allow-open-destination",
    "allow-check-application",
    "allow-check-tools",
    "allow-open-release",
    "allow-check-operation-preflight"
  ]
}
