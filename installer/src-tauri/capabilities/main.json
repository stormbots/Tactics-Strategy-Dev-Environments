{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: fixed workstation operations only",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-inspect-system",
    "allow-inspect-schedule",
    "allow-inspect-self-update",
    "allow-inspect-app-update",
    "allow-request-app-update",
    "allow-discover-app-update",
    "allow-inspect-app-update-progress",
    "allow-inspect-app-update-receipt",
    "allow-close-for-app-update",
    "allow-run-operation",
    "allow-open-destination"
  ]
}
