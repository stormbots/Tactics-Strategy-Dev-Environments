{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skyview Dev Setup",
  "version": "1.1.2",
  "identifier": "org.skyviewrobotics.devsetup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skyview Dev Setup",
        "width": 1040,
        "height": 820,
        "minWidth": 640,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "category": "DeveloperTool",
    "publisher": "Skyview Robotics",
    "shortDescription": "Student development workstation setup",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../windows/": "backend/windows/",
      "../../linux/": "backend/linux/"
    },
    "windows": {
      "nsis": { "installMode": "perMachine", "displayLanguageSelector": false }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "polkitd",
          "pkexec",
          "bash"
        ],
        "desktopTemplate": "skyview.desktop"
      }
    }
  }
}
