<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Skyview Robotics</vendor>
  <action id="org.skyviewrobotics.sde.app-update">
    <description>Prepare and install an SDE application update</description>
    <message>Prepare the latest eligible SDE update and install after all SDE windows close, including unexpected closure. No immediate cancellation. Tools and maintenance settings remain unchanged.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/skyview-app-update-request</annotate>
  </action>
</policyconfig>
